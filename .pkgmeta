package-as: AzerothMercantileExchange

externals:
  Libs/Ace3:
    url: https://github.com/WoWUIDev/Ace3.git
  Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate.git

  Libs/LibDataBroker-1.1:
    url: https://github.com/tekkub/libdatabroker-1-1.git
  Libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

move-folders:
  AzerothMercantileExchange/AzerothMercantileExchange_History: AzerothMercantileExchange_History

ignore:
  - docs
  - spec
  - spikes
  - bench
  - scripts
  - .github
  - .busted
  - .luacheckrc
  - .luarc.json
  - .stylua.toml
  - .vscode
  - README.md
